# Local development (bot running on this machine):
# BOT_START_URL="http://localhost:7860/start"

# Render:
BOT_START_URL="https://YOUR-SERVICE.onrender.com/start"

# Only set this if the bot expects a bearer token:
# BOT_START_PUBLIC_API_KEY=""

# Optional override if the WebSocket host differs from BOT_START_URL:
# BOT_WS_URL="wss://your-bot.example/ws-client"
