# For local development:
BOT_START_URL="http://localhost:7860/start"

# After Railway deploy, point this at the Railway /start URL:
# BOT_START_URL="https://your-bot.up.railway.app/start"
# Optional override if the WebSocket host differs from BOT_START_URL:
# BOT_WS_URL="wss://your-bot.up.railway.app/ws-client"

# Optional bot auth header:
# BOT_START_PUBLIC_API_KEY="your-api-key-here"