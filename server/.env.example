# Heybassh - Environment Variables
# Copy this file to .env and fill in your API keys


# GroqCloud (LLM, OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Local Moonshine STT (tiny is light enough for Render CPU)
MOONSHINE_STT_MODEL=tiny

# Piper TTS (local British voice by default)
PIPER_TTS_ENGINE=local
PIPER_TTS_VOICE=en_GB-cori-medium
PIPER_TTS_BASE_URL=https://piper-voices-production.up.railway.app
PIPER_TTS_TIMEOUT_SECS=60

# Optional: protect ElevenLabs webhooks with Authorization: Bearer <secret>
# ELEVENLABS_WEBHOOK_SECRET=

# Optional: JSON file used to persist student progress
# ENGLISH_PROGRESS_PATH=data/english_progress.json

# Optional: Daily rooms (`uv run bot.py -t daily` or transport=daily).
# DAILY_API_KEY=

# Optional: STUN/TURN for SmallWebRTC.
# PIPECAT_ICE_SERVERS=stun:stun.l.google.com:19302
#
# Required on Render for the hosted Connect UI (SmallWebRTC). STUN alone cannot
# finish ICE through Render's HTTP proxy. Use a TURN provider (Metered, Twilio,
# Cloudflare) and set:
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Optional: restrict the runner to one transport (daily | websocket | webrtc)
# PIPECAT_TRANSPORT=
