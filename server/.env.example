# Heybassh - Environment Variables
# Copy this file to .env and fill in your API keys


# Deepgram (STT)
DEEPGRAM_API_KEY=

# Google (LLM)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# Piper HTTP TTS (self-hosted)
PIPER_TTS_BASE_URL=https://piper-voices-production.up.railway.app
PIPER_TTS_TIMEOUT_SECS=60

# Optional: protect ElevenLabs webhooks with Authorization: Bearer <secret>
# ELEVENLABS_WEBHOOK_SECRET=

# Optional: JSON file used to persist student progress
# ENGLISH_PROGRESS_PATH=data/english_progress.json

# Production (Railway): comma-separated browser origins allowed to open the WebSocket
# PIPECAT_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
